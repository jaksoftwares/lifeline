# Copy to apps/api/.env for local development.

# Local Postgres from infra/docker-compose.yml (host port 5442)
DATABASE_URL=postgresql://lifeline:lifeline@localhost:5442/lifeline

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=change-me

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Password given to every seeded demo user. Local development only.
SEED_DEMO_PASSWORD=Lifeline-Demo-2026
