# Copy to .env.local and fill in from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Database password (Supabase → Project Settings → Database), used only by the db:* scripts.
SUPABASE_DB_PASSWORD=

# Email (Postmark). Leave POSTMARK_API_TOKEN empty to turn email off.
POSTMARK_API_TOKEN=
# Optional: sender (must be verified in Postmark). Default: Afyaline <notifications@dovepeakdigital.com>
EMAIL_FROM=
# Afyaline team addresses (comma-separated): told when a new organization registers.
ADMIN_EMAILS=
# Public address of the app, for links in emails. On Vercel this is detected automatically.
APP_URL=
