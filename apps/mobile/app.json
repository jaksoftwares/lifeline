{
  "expo": {
    "name": "Lifeline Crew",
    "slug": "lifeline-crew",
    "scheme": "lifelinecrew",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.lifeline.crew",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lifeline shares your ambulance’s position with the facilities during a transfer.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Lifeline keeps sharing your ambulance’s position during a transfer while the app is in the background.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "org.lifeline.crew",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://10.0.2.2:4000/api"
    }
  }
}
