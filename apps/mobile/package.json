{
  "name": "@lifeline/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export": "expo export --platform android --output-dir dist",
    "lint": "eslint app src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.14",
    "@lifeline/domain": "workspace:*",
    "@lifeline/schemas": "workspace:*",
    "@lifeline/tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.14",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.7",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.13",
    "expo-location": "58.0.17",
    "expo-network": "58.0.3",
    "expo-router": "58.0.23",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "expo-task-manager": "58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
