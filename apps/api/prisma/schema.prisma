// Lifeline database schema.
// Phase 0: identity, institutions, memberships, sessions and audit.
// Phase 1: facility profiles, service and capacity catalogue, departments, capacity reporting.
// Phase 2: patients, referrals, per-facility requests, messages, clinical assessments, attachments.
// Phase 3: vehicles, crew, transfers, dispatch assignments and transfer history.
// Phase 4: crew-app status updates (with device time and idempotency key) and location pings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstitutionType {
  FACILITY
  AMBULANCE_PROVIDER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

// Mirrors ROLES in @lifeline/domain.
enum Ownership {
  PUBLIC
  PRIVATE
  FAITH_BASED
  NGO
}

enum ResourceKind {
  BED
  EQUIPMENT
  SPECIALIST
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum CapacitySource {
  MANUAL
  INTEGRATION
}

enum EarlyWarningScore {
  NONE
  MEWS
  NEWS2
}

enum ReferralStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  CANCELLED
}

enum RequestStatus {
  PENDING
  INFO_REQUESTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum Urgency {
  EMERGENCY
  URGENT
  ROUTINE
}

enum DeclineReason {
  NO_BED
  NO_SPECIALIST
  NO_EQUIPMENT
  SERVICE_NOT_OFFERED
  CLINICALLY_INAPPROPRIATE
  OTHER
}

enum Sex {
  FEMALE
  MALE
  INTERSEX
  UNKNOWN
}

enum PregnancyStatus {
  NOT_PREGNANT
  PREGNANT
  POSTPARTUM
  UNKNOWN
  NOT_APPLICABLE
}

enum AgeUnit {
  YEARS
  MONTHS
  DAYS
}

enum Consciousness {
  ALERT
  CONFUSION
  VOICE
  PAIN
  UNRESPONSIVE
}

enum MessageKind {
  NOTE
  INFO_REQUEST
  INFO_RESPONSE
}

enum ReferralEventType {
  CREATED
  SUBMITTED
  REQUEST_SENT
  INFO_REQUESTED
  INFO_PROVIDED
  ACCEPTED
  DECLINED
  WITHDRAWN
  CANCELLED
  ASSESSMENT_RECORDED
  ATTACHMENT_ADDED
}

enum CapabilityLevel {
  PATIENT_TRANSPORT
  BLS
  ALS
  CRITICAL_CARE
}

enum VehicleStatus {
  AVAILABLE
  OUT_OF_SERVICE
  OFF_DUTY
}

enum CrewQualification {
  DRIVER
  EMT
  PARAMEDIC
  NURSE
  CLINICAL_OFFICER
  DOCTOR
}

enum TransferStatus {
  AWAITING_TRANSPORT
  AMBULANCE_ASSIGNED
  DISPATCHED
  AT_PICKUP
  PATIENT_COLLECTED
  IN_TRANSIT
  ARRIVED
  HANDED_OVER
  COMPLETED
  INTERRUPTED
  CANCELLED
}

enum AssignmentKind {
  PROVIDER
  EXTERNAL
}

enum AssignmentStatus {
  PROPOSED
  CONFIRMED
  DECLINED
  WITHDRAWN
  RELEASED
  COMPLETED
}

enum AssignmentDeclineReason {
  NO_VEHICLE
  NO_CREW
  VEHICLE_UNSUITABLE
  TOO_FAR
  OTHER
}

enum ExternalTransportService {
  NATIONAL_922
  COUNTY_AMBULANCE
  OTHER
}

enum TransferEventType {
  REQUESTED
  UPDATED
  OFFERED
  OFFER_WITHDRAWN
  CONFIRMED
  DECLINED
  REASSIGNED
  RELEASED
  EXTERNAL_ARRANGED
  DISPATCHED
  CANCELLED
  AT_PICKUP
  PATIENT_COLLECTED
  IN_TRANSIT
  ARRIVED
  INTERRUPTED
  RESUMED
}

enum EventSource {
  WEB
  CREW_APP
}

enum Role {
  REFERRING_CLINICIAN
  REFERRAL_COORDINATOR
  RECEIVING_DECISION_MAKER
  FACILITY_ADMIN
  DISPATCHER
  AMBULANCE_CREW
  PROVIDER_ADMIN
  NETWORK_OPERATIONS
  NETWORK_ADMIN
  AUDITOR
}

/// A referral network, e.g. a county or a referral hospital and its feeder facilities. The tenant boundary.
model Network {
  id                             String            @id @default(cuid())
  code                           String            @unique
  name                           String
  /// Capacity reports older than this are shown as stale.
  capacityStaleAfterMinutes      Int               @default(240)
  /// Early-warning score shown on referrals. NONE until clinical governance approves one.
  earlyWarningScore              EarlyWarningScore @default(NONE)
  /// Last issued referral number, for human-readable references.
  referralSequence               Int               @default(0)
  /// Vehicles whose availability hasn't been confirmed for longer than this are not suggested.
  vehicleStatusStaleAfterMinutes Int               @default(720)
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  institutions Institution[]
  memberships  Membership[]
  auditEvents  AuditEvent[]
  services     Service[]
  resources    CapacityResource[]
  patients     Patient[]
  referrals    Referral[]
  vehicles     Vehicle[]
  transfers    Transfer[]
}

/// A healthcare facility or an ambulance provider participating in a network.
model Institution {
  id        String          @id @default(cuid())
  networkId String
  network   Network         @relation(fields: [networkId], references: [id])
  type      InstitutionType
  name      String
  code      String
  /// KEPH level (1–6) for facilities; null for ambulance providers.
  level     Int?
  county    String?
  ownership Ownership?
  address   String?
  /// Main switchboard or referral desk number.
  phone     String?
  latitude  Float?
  longitude Float?
  status    RecordStatus    @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  memberships     Membership[]
  auditEvents     AuditEvent[]
  services        FacilityService[]
  resources       FacilityResource[]
  departments     Department[]
  capacityUpdates CapacityUpdate[]

  referralsSent       Referral[]        @relation("referring")
  referralRequests    ReferralRequest[] @relation("receiving")
  referralMessages    ReferralMessage[]
  referralEvents      ReferralEvent[]
  referralAttachments Attachment[]

  vehicles            Vehicle[]
  crewMembers         CrewMember[]
  transfersFrom       Transfer[]           @relation("pickup")
  transfersTo         Transfer[]           @relation("destination")
  dispatchAssignments DispatchAssignment[]
  transferEvents      TransferEvent[]

  @@unique([networkId, code])
  @@index([networkId, type])
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  fullName           String
  phone              String?
  passwordHash       String
  mustChangePassword Boolean    @default(true)
  passwordChangedAt  DateTime?
  status             UserStatus @default(ACTIVE)

  mfaEnabled       Boolean @default(false)
  /// AES-256-GCM encrypted TOTP secret.
  mfaSecret        String?
  /// Encrypted secret awaiting confirmation during enrolment.
  mfaPendingSecret String?
  /// Last accepted TOTP time step; codes at or before it are rejected to stop replay.
  mfaLastUsedStep  Int?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships        Membership[]       @relation("member")
  grantedMemberships Membership[]       @relation("grantedBy")
  sessions           Session[]
  auditEvents        AuditEvent[]
  capacityUpdates    CapacityUpdate[]
  currentCapacity    FacilityResource[]

  referralsCreated    Referral[]
  requestsSent        ReferralRequest[]    @relation("requestSentBy")
  requestsAnswered    ReferralRequest[]    @relation("requestRespondedBy")
  referralMessages    ReferralMessage[]
  assessmentsRecorded ClinicalAssessment[]
  attachmentsUploaded Attachment[]
  referralEvents      ReferralEvent[]

  vehicleStatusUpdates Vehicle[]
  crewProfiles         CrewMember[]
  transfersRequested   Transfer[]
  assignmentsProposed  DispatchAssignment[] @relation("assignmentProposedBy")
  assignmentsAnswered  DispatchAssignment[] @relation("assignmentRespondedBy")
  transferEvents       TransferEvent[]
  locationPings        LocationPing[]
}

/// A role held by a user, either at one institution or (institutionId null) across a network.
model Membership {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("member", fields: [userId], references: [id], onDelete: Cascade)
  networkId     String
  network       Network      @relation(fields: [networkId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  role          Role
  grantedById   String?
  grantedBy     User?        @relation("grantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  // Postgres treats NULLs as distinct, so duplicate network-wide roles are also checked in the service.
  @@unique([userId, networkId, institutionId, role])
  @@index([networkId, institutionId])
}

/// A signed-in device. The refresh token is `<session id>.<secret>`; only a hash of the secret is stored.
model Session {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash         String
  previousRefreshHash String?
  rotatedAt           DateTime?
  expiresAt           DateTime
  lastUsedAt          DateTime  @default(now())
  revokedAt           DateTime?
  revokedReason       String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
}

/// Append-only record of security and administrative actions. Updates and deletes are blocked by a trigger.
model AuditEvent {
  id            String       @id @default(cuid())
  occurredAt    DateTime     @default(now())
  action        String
  actorId       String?
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  networkId     String?
  network       Network?     @relation(fields: [networkId], references: [id], onDelete: Restrict)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  entityType    String
  entityId      String?
  ipAddress     String?
  userAgent     String?
  metadata      Json         @default("{}")

  @@index([networkId, occurredAt])
  @@index([institutionId, occurredAt])
  @@index([actorId, occurredAt])
}

/// A service a facility can offer, from the network's catalogue (e.g. neurosurgery, CT imaging).
model Service {
  id        String  @id @default(cuid())
  networkId String
  network   Network @relation(fields: [networkId], references: [id])
  code      String
  name      String
  category  String
  sortOrder Int     @default(0)

  facilities FacilityService[]
  referrals  ReferralService[]

  @@unique([networkId, code])
}

model FacilityService {
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  createdAt     DateTime    @default(now())

  @@id([institutionId, serviceId])
  @@index([serviceId])
}

/// Something a facility reports availability for: a bed type, equipment or an on-call specialist.
model CapacityResource {
  id        String       @id @default(cuid())
  networkId String
  network   Network      @relation(fields: [networkId], references: [id])
  code      String
  name      String
  kind      ResourceKind
  sortOrder Int          @default(0)

  facilities FacilityResource[]
  updates    CapacityUpdate[]

  @@unique([networkId, code])
}

/// A resource a facility tracks, with its latest reported availability (null until first reported).
model FacilityResource {
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  resourceId    String
  resource      CapacityResource    @relation(fields: [resourceId], references: [id])
  status        AvailabilityStatus?
  available     Int?
  total         Int?
  note          String?
  source        CapacitySource?
  updatedAt     DateTime?
  updatedById   String?
  updatedBy     User?               @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())

  @@id([institutionId, resourceId])
  @@index([resourceId, status])
}

/// Append-only history of capacity reports. Updates and deletes are blocked by a trigger.
model CapacityUpdate {
  id            String             @id @default(cuid())
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  resourceId    String
  resource      CapacityResource   @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  status        AvailabilityStatus
  available     Int?
  total         Int?
  note          String?
  source        CapacitySource     @default(MANUAL)
  recordedById  String?
  recordedBy    User?              @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt    DateTime           @default(now())

  @@index([institutionId, resourceId, recordedAt])
}

/// A department or unit within a facility, with a direct contact for referrals.
model Department {
  id               String            @id @default(cuid())
  institutionId    String
  institution      Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  acceptedRequests ReferralRequest[]
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([institutionId])
}

/// The person being referred. Holds only what coordination needs; full records stay in hospital systems.
model Patient {
  id               String    @id @default(cuid())
  networkId        String
  network          Network   @relation(fields: [networkId], references: [id])
  /// Null for an unidentified patient.
  fullName         String?
  sex              Sex
  dateOfBirth      DateTime? @db.Date
  estimatedAge     Int?
  estimatedAgeUnit AgeUnit?
  nationalId       String?
  shaNumber        String?
  hospitalNumber   String?
  nextOfKinName    String?
  nextOfKinPhone   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  referrals Referral[]
}

model Referral {
  id                     String           @id @default(cuid())
  networkId              String
  network                Network          @relation(fields: [networkId], references: [id])
  /// Human-readable, e.g. DEMO-26-00042.
  reference              String           @unique
  status                 ReferralStatus   @default(DRAFT)
  /// Clinician-assigned; separate from any calculated score.
  urgency                Urgency?
  referringInstitutionId String
  referringInstitution   Institution      @relation("referring", fields: [referringInstitutionId], references: [id])
  createdById            String
  createdBy              User             @relation(fields: [createdById], references: [id])
  patientId              String
  patient                Patient          @relation(fields: [patientId], references: [id])
  pregnancyStatus        PregnancyStatus?
  gestationWeeks         Int?
  reason                 String?
  clinicalSummary        String?
  provisionalDiagnosis   String?
  treatmentGiven         String?
  allergies              String?
  acceptedRequestId      String?          @unique
  submittedAt            DateTime?
  acceptedAt             DateTime?
  cancelledAt            DateTime?
  cancelReason           String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  requiredServices ReferralService[]
  requests         ReferralRequest[]    @relation("requests")
  acceptedRequest  ReferralRequest?     @relation("accepted", fields: [acceptedRequestId], references: [id])
  assessments      ClinicalAssessment[]
  attachments      Attachment[]
  events           ReferralEvent[]
  transfers        Transfer[]

  @@index([networkId, status])
  @@index([referringInstitutionId, status])
}

model ReferralService {
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])

  @@id([referralId, serviceId])
}

/// The referral as sent to one receiving facility, with that facility's answer.
model ReferralRequest {
  id                    String         @id @default(cuid())
  referralId            String
  referral              Referral       @relation("requests", fields: [referralId], references: [id])
  institutionId         String
  institution           Institution    @relation("receiving", fields: [institutionId], references: [id])
  status                RequestStatus  @default(PENDING)
  sentAt                DateTime       @default(now())
  sentById              String
  sentBy                User           @relation("requestSentBy", fields: [sentById], references: [id])
  respondedAt           DateTime?
  respondedById         String?
  respondedBy           User?          @relation("requestRespondedBy", fields: [respondedById], references: [id])
  declineReason         DeclineReason?
  /// Acceptance conditions or decline details.
  responseNote          String?
  receivingDepartmentId String?
  receivingDepartment   Department?    @relation(fields: [receivingDepartmentId], references: [id], onDelete: SetNull)
  /// When the receiving facility expects to be ready for the patient.
  readyAt               DateTime?
  withdrawnAt           DateTime?
  withdrawReason        String?

  messages    ReferralMessage[]
  events      ReferralEvent[]
  acceptedFor Referral?         @relation("accepted")

  @@unique([referralId, institutionId])
  @@index([institutionId, status])
}

/// Conversation between the referring facility and one receiving facility. Append-only.
model ReferralMessage {
  id                  String          @id @default(cuid())
  requestId           String
  request             ReferralRequest @relation(fields: [requestId], references: [id])
  kind                MessageKind     @default(NOTE)
  body                String
  authorId            String
  author              User            @relation(fields: [authorId], references: [id])
  authorInstitutionId String
  authorInstitution   Institution     @relation(fields: [authorInstitutionId], references: [id])
  createdAt           DateTime        @default(now())

  @@index([requestId, createdAt])
}

/// A set of observations. The score is calculated and stored when recorded, with the definition used. Append-only.
model ClinicalAssessment {
  id                   String             @id @default(cuid())
  referralId           String
  referral             Referral           @relation(fields: [referralId], references: [id])
  recordedById         String
  recordedBy           User               @relation(fields: [recordedById], references: [id])
  /// When the observations were taken.
  observedAt           DateTime
  createdAt            DateTime           @default(now())
  respiratoryRate      Int?
  oxygenSaturation     Int?
  onSupplementalOxygen Boolean?
  systolicBp           Int?
  diastolicBp          Int?
  heartRate            Int?
  temperature          Float?
  consciousness        Consciousness?
  bloodGlucose         Float?
  notes                String?
  scoreType            EarlyWarningScore?
  scoreTotal           Int?
  scoreBand            String?
  /// Why no score was calculated (not applicable, observations missing).
  scoreNote            String?

  @@index([referralId, observedAt])
}

/// A clinical document attached to a referral, stored in the database for the pilot.
model Attachment {
  id                      String      @id @default(cuid())
  referralId              String
  referral                Referral    @relation(fields: [referralId], references: [id])
  fileName                String
  contentType             String
  sizeBytes               Int
  sha256                  String
  data                    Bytes
  uploadedById            String
  uploadedBy              User        @relation(fields: [uploadedById], references: [id])
  uploadedByInstitutionId String
  uploadedByInstitution   Institution @relation(fields: [uploadedByInstitutionId], references: [id])
  createdAt               DateTime    @default(now())

  @@index([referralId])
}

/// Append-only history of a referral: every status change, with who and when.
model ReferralEvent {
  id            String            @id @default(cuid())
  referralId    String
  referral      Referral          @relation(fields: [referralId], references: [id])
  /// Set when the event concerns one receiving facility's request.
  requestId     String?
  request       ReferralRequest?  @relation(fields: [requestId], references: [id])
  type          ReferralEventType
  actorId       String?
  actor         User?             @relation(fields: [actorId], references: [id])
  institutionId String?
  institution   Institution?      @relation(fields: [institutionId], references: [id])
  note          String?
  metadata      Json              @default("{}")
  occurredAt    DateTime          @default(now())

  @@index([referralId, occurredAt])
}

/// An ambulance belonging to a provider (an independent service or a hospital's own ambulance unit).
model Vehicle {
  id                String          @id @default(cuid())
  networkId         String
  network           Network         @relation(fields: [networkId], references: [id])
  institutionId     String
  institution       Institution     @relation(fields: [institutionId], references: [id])
  /// Number plate, upper case with single spaces.
  registration      String
  callSign          String?
  capability        CapabilityLevel
  /// Codes from VEHICLE_EQUIPMENT in @lifeline/domain.
  equipment         String[]
  /// New vehicles stay off duty until a dispatcher confirms they're available.
  status            VehicleStatus   @default(OFF_DUTY)
  statusNote        String?
  statusUpdatedAt   DateTime?
  statusUpdatedById String?
  statusUpdatedBy   User?           @relation(fields: [statusUpdatedById], references: [id], onDelete: SetNull)
  baseName          String?
  baseLatitude      Float?
  baseLongitude     Float?
  /// Latest position reported by the crew app (Phase 5); null until then.
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationAt    DateTime?
  recordStatus      RecordStatus    @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  assignments DispatchAssignment[]
  locations   LocationPing[]

  @@unique([networkId, registration])
  @@index([institutionId])
}

/// A person who crews a provider's ambulances. Linked to a Lifeline account when they use the crew app.
/// Crews are put together per trip, since shifts change; there is no fixed team record.
model CrewMember {
  id            String            @id @default(cuid())
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id])
  userId        String?
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName      String
  phone         String?
  qualification CrewQualification
  recordStatus  RecordStatus      @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  assignments AssignmentCrew[]

  @@unique([institutionId, userId])
  @@index([institutionId])
}

/// Moving an accepted referral's patient from the referring facility to the receiving one.
/// One open transfer per referral, enforced by a partial unique index in the migration.
model Transfer {
  id                       String          @id @default(cuid())
  networkId                String
  network                  Network         @relation(fields: [networkId], references: [id])
  referralId               String
  referral                 Referral        @relation(fields: [referralId], references: [id])
  status                   TransferStatus  @default(AWAITING_TRANSPORT)
  pickupInstitutionId      String
  pickupInstitution        Institution     @relation("pickup", fields: [pickupInstitutionId], references: [id])
  destinationInstitutionId String
  destinationInstitution   Institution     @relation("destination", fields: [destinationInstitutionId], references: [id])
  requiredCapability       CapabilityLevel
  requiredEquipment        String[]
  /// When the patient will be ready for collection; null means now.
  readyAt                  DateTime?
  /// For the crew, e.g. oxygen requirement or immobilisation.
  notes                    String?
  requestedById            String
  requestedBy              User            @relation(fields: [requestedById], references: [id])
  requestedAt              DateTime        @default(now())
  assignedAt               DateTime?
  dispatchedAt             DateTime?
  /// Journey times from the crew app, in device time.
  atPickupAt               DateTime?
  collectedAt              DateTime?
  arrivedAt                DateTime?
  cancelledAt              DateTime?
  cancelReason             String?
  updatedAt                DateTime        @updatedAt

  assignments DispatchAssignment[]
  events      TransferEvent[]
  locations   LocationPing[]

  @@index([networkId, status])
  @@index([pickupInstitutionId, status])
  @@index([destinationInstitutionId, status])
}

/// A transfer offered to a provider's vehicle, or transport arranged outside Lifeline.
/// Partial unique indexes keep one open assignment per transfer and one confirmed trip per vehicle.
model DispatchAssignment {
  id               String                    @id @default(cuid())
  transferId       String
  transfer         Transfer                  @relation(fields: [transferId], references: [id])
  kind             AssignmentKind
  status           AssignmentStatus
  providerId       String?
  provider         Institution?              @relation(fields: [providerId], references: [id])
  vehicleId        String?
  vehicle          Vehicle?                  @relation(fields: [vehicleId], references: [id])
  proposedById     String
  proposedBy       User                      @relation("assignmentProposedBy", fields: [proposedById], references: [id])
  proposedAt       DateTime                  @default(now())
  /// The arranger's note to the provider.
  note             String?
  respondedById    String?
  respondedBy      User?                     @relation("assignmentRespondedBy", fields: [respondedById], references: [id])
  respondedAt      DateTime?
  declineReason    AssignmentDeclineReason?
  responseNote     String?
  /// The provider's estimate of minutes to pickup, given when confirming.
  etaMinutes       Int?
  endedAt          DateTime?
  endReason        String?
  externalService  ExternalTransportService?
  externalProvider String?
  externalVehicle  String?
  externalPhone    String?

  crew      AssignmentCrew[]
  events    TransferEvent[]
  locations LocationPing[]

  @@index([transferId])
  @@index([providerId, status])
  @@index([vehicleId, status])
}

model AssignmentCrew {
  assignmentId String
  assignment   DispatchAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  crewMemberId String
  crewMember   CrewMember         @relation(fields: [crewMemberId], references: [id])

  @@id([assignmentId, crewMemberId])
  @@index([crewMemberId])
}

/// Append-only history of a transfer: every offer, answer and status change, with who and when.
model TransferEvent {
  id            String              @id @default(cuid())
  transferId    String
  transfer      Transfer            @relation(fields: [transferId], references: [id])
  assignmentId  String?
  assignment    DispatchAssignment? @relation(fields: [assignmentId], references: [id])
  type          TransferEventType
  actorId       String?
  actor         User?               @relation(fields: [actorId], references: [id])
  institutionId String?
  institution   Institution?        @relation(fields: [institutionId], references: [id])
  note          String?
  metadata      Json                @default("{}")
  /// When it happened. For crew-app updates this is the device time of the button press.
  occurredAt    DateTime            @default(now())
  /// When the server received it; later than occurredAt for updates queued offline.
  receivedAt    DateTime            @default(now())
  source        EventSource         @default(WEB)
  /// Generated by the crew app for each press, so retried uploads are recorded once.
  clientId      String?             @unique

  @@index([transferId, occurredAt])
}

/// A position reported by the crew app during a trip. Append-only.
model LocationPing {
  id           String             @id @default(cuid())
  transferId   String
  transfer     Transfer           @relation(fields: [transferId], references: [id])
  assignmentId String
  assignment   DispatchAssignment @relation(fields: [assignmentId], references: [id])
  vehicleId    String?
  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id])
  recordedById String
  recordedBy   User               @relation(fields: [recordedById], references: [id])
  latitude     Float
  longitude    Float
  /// Metres.
  accuracy     Float?
  speed        Float?
  heading      Float?
  /// Device time of the fix.
  recordedAt   DateTime
  receivedAt   DateTime           @default(now())

  @@unique([assignmentId, recordedAt])
  @@index([transferId, recordedAt])
  @@index([vehicleId, recordedAt])
}
