// Lifeline database schema.
// Phase 0: identity, institutions, memberships, sessions and audit.
// Phase 1: facility profiles, service and capacity catalogue, departments, capacity reporting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstitutionType {
  FACILITY
  AMBULANCE_PROVIDER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

// Mirrors ROLES in @lifeline/domain.
enum Ownership {
  PUBLIC
  PRIVATE
  FAITH_BASED
  NGO
}

enum ResourceKind {
  BED
  EQUIPMENT
  SPECIALIST
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum CapacitySource {
  MANUAL
  INTEGRATION
}

enum Role {
  REFERRING_CLINICIAN
  REFERRAL_COORDINATOR
  RECEIVING_DECISION_MAKER
  FACILITY_ADMIN
  DISPATCHER
  AMBULANCE_CREW
  PROVIDER_ADMIN
  NETWORK_OPERATIONS
  NETWORK_ADMIN
  AUDITOR
}

/// A referral network, e.g. a county or a referral hospital and its feeder facilities. The tenant boundary.
model Network {
  id                        String   @id @default(cuid())
  code                      String   @unique
  name                      String
  /// Capacity reports older than this are shown as stale.
  capacityStaleAfterMinutes Int      @default(240)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  institutions Institution[]
  memberships  Membership[]
  auditEvents  AuditEvent[]
  services     Service[]
  resources    CapacityResource[]
}

/// A healthcare facility or an ambulance provider participating in a network.
model Institution {
  id        String          @id @default(cuid())
  networkId String
  network   Network         @relation(fields: [networkId], references: [id])
  type      InstitutionType
  name      String
  code      String
  /// KEPH level (1–6) for facilities; null for ambulance providers.
  level     Int?
  county    String?
  ownership Ownership?
  address   String?
  /// Main switchboard or referral desk number.
  phone     String?
  latitude  Float?
  longitude Float?
  status    RecordStatus    @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  memberships     Membership[]
  auditEvents     AuditEvent[]
  services        FacilityService[]
  resources       FacilityResource[]
  departments     Department[]
  capacityUpdates CapacityUpdate[]

  @@unique([networkId, code])
  @@index([networkId, type])
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  fullName           String
  phone              String?
  passwordHash       String
  mustChangePassword Boolean    @default(true)
  passwordChangedAt  DateTime?
  status             UserStatus @default(ACTIVE)

  mfaEnabled       Boolean @default(false)
  /// AES-256-GCM encrypted TOTP secret.
  mfaSecret        String?
  /// Encrypted secret awaiting confirmation during enrolment.
  mfaPendingSecret String?
  /// Last accepted TOTP time step; codes at or before it are rejected to stop replay.
  mfaLastUsedStep  Int?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships        Membership[]       @relation("member")
  grantedMemberships Membership[]       @relation("grantedBy")
  sessions           Session[]
  auditEvents        AuditEvent[]
  capacityUpdates    CapacityUpdate[]
  currentCapacity    FacilityResource[]
}

/// A role held by a user, either at one institution or (institutionId null) across a network.
model Membership {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation("member", fields: [userId], references: [id], onDelete: Cascade)
  networkId     String
  network       Network      @relation(fields: [networkId], references: [id])
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id])
  role          Role
  grantedById   String?
  grantedBy     User?        @relation("grantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  // Postgres treats NULLs as distinct, so duplicate network-wide roles are also checked in the service.
  @@unique([userId, networkId, institutionId, role])
  @@index([networkId, institutionId])
}

/// A signed-in device. The refresh token is `<session id>.<secret>`; only a hash of the secret is stored.
model Session {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash         String
  previousRefreshHash String?
  rotatedAt           DateTime?
  expiresAt           DateTime
  lastUsedAt          DateTime  @default(now())
  revokedAt           DateTime?
  revokedReason       String?
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime  @default(now())

  @@index([userId])
}

/// Append-only record of security and administrative actions. Updates and deletes are blocked by a trigger.
model AuditEvent {
  id            String       @id @default(cuid())
  occurredAt    DateTime     @default(now())
  action        String
  actorId       String?
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  networkId     String?
  network       Network?     @relation(fields: [networkId], references: [id], onDelete: Restrict)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  entityType    String
  entityId      String?
  ipAddress     String?
  userAgent     String?
  metadata      Json         @default("{}")

  @@index([networkId, occurredAt])
  @@index([institutionId, occurredAt])
  @@index([actorId, occurredAt])
}

/// A service a facility can offer, from the network's catalogue (e.g. neurosurgery, CT imaging).
model Service {
  id        String  @id @default(cuid())
  networkId String
  network   Network @relation(fields: [networkId], references: [id])
  code      String
  name      String
  category  String
  sortOrder Int     @default(0)

  facilities FacilityService[]

  @@unique([networkId, code])
}

model FacilityService {
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  createdAt     DateTime    @default(now())

  @@id([institutionId, serviceId])
  @@index([serviceId])
}

/// Something a facility reports availability for: a bed type, equipment or an on-call specialist.
model CapacityResource {
  id        String       @id @default(cuid())
  networkId String
  network   Network      @relation(fields: [networkId], references: [id])
  code      String
  name      String
  kind      ResourceKind
  sortOrder Int          @default(0)

  facilities FacilityResource[]
  updates    CapacityUpdate[]

  @@unique([networkId, code])
}

/// A resource a facility tracks, with its latest reported availability (null until first reported).
model FacilityResource {
  institutionId String
  institution   Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  resourceId    String
  resource      CapacityResource    @relation(fields: [resourceId], references: [id])
  status        AvailabilityStatus?
  available     Int?
  total         Int?
  note          String?
  source        CapacitySource?
  updatedAt     DateTime?
  updatedById   String?
  updatedBy     User?               @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())

  @@id([institutionId, resourceId])
  @@index([resourceId, status])
}

/// Append-only history of capacity reports. Updates and deletes are blocked by a trigger.
model CapacityUpdate {
  id            String             @id @default(cuid())
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  resourceId    String
  resource      CapacityResource   @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  status        AvailabilityStatus
  available     Int?
  total         Int?
  note          String?
  source        CapacitySource     @default(MANUAL)
  recordedById  String?
  recordedBy    User?              @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt    DateTime           @default(now())

  @@index([institutionId, resourceId, recordedAt])
}

/// A department or unit within a facility, with a direct contact for referrals.
model Department {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId])
}
